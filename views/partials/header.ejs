<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | SPK Sarastya</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <div class="sidebar-brand"><img class="brand-logo" src="/sarastya-logo.png" alt="Logo Sarastya Agility Innovations"><div><strong>Sarastya Agility Innovations</strong><span>Sistem Pendukung Keputusan Rekrutmen PKL/Magang</span></div></div>
    <div class="nav-label">MENU UTAMA</div>
    <% const links = [['dashboard','Dashboard Rekrutmen'],['periods','Periode Seleksi'],['users','Kelola Akun Tim Rekrutmen'],['candidates','Data Kandidat'],['criteria','Kriteria'],['swara','Bobot Kriteria'],['ranking','Rangking Penilaian']]; %>
    <% for (const [route,label] of links) { %>
      <% if (!(user.role === 'recruiter' && ['periods','users','swara'].includes(route))) { %>
        <a class="nav-link <%= page === route ? 'active' : '' %>" href="/<%= route %>"><%= label %></a>
      <% } %>
    <% } %>
  </aside>
  <main class="main">
    <% const profileLabel = user.role === 'super_admin' ? 'HG Sarastya' : `Tim Rekrutmen - ${user.business_unit}`; %>
    <header class="topbar">
      <strong><%= title %></strong>
      <details class="profile-menu">
        <summary>
          <span class="profile-avatar"><%= user.role === 'super_admin' ? 'HG' : 'TR' %></span>
          <span class="profile-summary-text">
            <strong><%= profileLabel %></strong>
            <small><%= user.username %></small>
          </span>
        </summary>
        <div class="profile-dropdown">
          <div class="profile-info">
            <span>Profil Pengguna</span>
            <strong><%= profileLabel %></strong>
            <small><%= user.role === 'super_admin' ? 'Super Admin' : user.business_unit %></small>
          </div>
          <div class="profile-actions">
            <a class="btn secondary" href="/profile">Edit Profil</a>
            <a class="btn secondary profile-logout" href="/logout" onclick="return confirm('Apakah Anda akan logout dari sistem?')">Keluar</a>
          </div>
        </div>
      </details>
    </header>
    <section class="content">
      <% if (flash) { %><div class="notice <%= flash.type === 'error' ? 'error' : '' %>"><%= flash.message %></div><% } %>
