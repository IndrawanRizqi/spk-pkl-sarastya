<%- include('partials/header') %>
<div class="page-head dashboard-head">
  <div>
    <h1>Dashboard Rekrutmen PKL/Magang</h1>
    <p>Ringkasan keputusan seleksi dan asal instansi pendaftar berdasarkan periode.</p>
  </div>
  <form method="get" class="dashboard-filter">
    <label>Filter Periode</label>
    <select name="period_id" onchange="this.form.submit()">
      <% for (const period of periods) { %>
        <option value="<%= period.id %>" <%= periodId === period.id ? 'selected' : '' %>><%= period.name %> <%= period.year %></option>
      <% } %>
    </select>
  </form>
</div>

<div class="period-summary">
  <div class="period-active-card">
    <span>Periode Aktif</span>
    <strong><%= activePeriod ? `${activePeriod.name} ${activePeriod.year}` : 'Belum ada periode' %></strong>
  </div>
  <div class="period-active-card selected">
    <span>Data Ditampilkan</span>
    <strong><%= selectedPeriod ? `${selectedPeriod.name} ${selectedPeriod.year}` : 'Belum ada periode' %></strong>
  </div>
</div>

<div class="grid stats dashboard-stats">
  <% for (const [label,value] of Object.entries(stats)) { %>
    <div class="stat">
      <span><%= label %></span>
      <strong><%= value %></strong>
    </div>
  <% } %>
</div>

<%
  const institutionMax = Math.max(...institutionChart.map((item) => item.value), 1);
  const statusMax = Math.max(...statusChart.map((item) => item.value), 1);
  const unitMax = Math.max(...unitStatusChart.flatMap((item) => [item.accepted, item.rejected]), 1);
%>

<div class="dashboard-charts">
  <div class="card chart-card">
    <h2>Jumlah Pendaftar SMK & Perguruan Tinggi</h2>
    <p class="muted">Disesuaikan dengan periode yang dipilih.</p>
    <div class="bar-chart">
      <% for (const item of institutionChart) { %>
        <div class="bar-row">
          <div class="bar-label"><%= item.label %></div>
          <div class="bar-track">
            <div class="bar-fill <%= item.className %>" style="width: <%= Math.round((item.value / institutionMax) * 100) %>%"></div>
          </div>
          <strong><%= item.value %></strong>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card chart-card">
    <h2>Pendaftar Diterima & Ditolak</h2>
    <p class="muted">Ringkasan keputusan seleksi pada periode terpilih.</p>
    <div class="bar-chart">
      <% for (const item of statusChart) { %>
        <div class="bar-row">
          <div class="bar-label"><%= item.label %></div>
          <div class="bar-track">
            <div class="bar-fill <%= item.className %>" style="width: <%= Math.round((item.value / statusMax) * 100) %>%"></div>
          </div>
          <strong><%= item.value %></strong>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card chart-card wide">
    <h2>Pendaftar Diterima & Ditolak Setiap Unit Bisnis</h2>
    <p class="muted">Perbandingan keputusan seleksi untuk setiap unit bisnis pada periode terpilih.</p>
    <div class="unit-chart">
      <% for (const item of unitStatusChart) { %>
        <div class="unit-row">
          <div class="unit-name"><%= item.unit %></div>
          <div class="unit-bars">
            <div class="mini-bar accepted">
              <span>Diterima</span>
              <div class="bar-track"><div class="bar-fill accepted" style="width: <%= Math.round((item.accepted / unitMax) * 100) %>%"></div></div>
              <strong><%= item.accepted %></strong>
            </div>
            <div class="mini-bar rejected">
              <span>Ditolak</span>
              <div class="bar-track"><div class="bar-fill rejected" style="width: <%= Math.round((item.rejected / unitMax) * 100) %>%"></div></div>
              <strong><%= item.rejected %></strong>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
