<%- include('partials/header') %>

<div class="page-head"><div><h1>Bobot Kriteria</h1></div></div>

<div class="grid two-col weight-overview">
  <div class="stat"><span>Total Bobot</span><strong id="weight-total"><%= number(totalWeight,6) %></strong></div>
  <div class="stat"><span>Status Bobot</span><strong id="weight-status" class="<%= state.weights_ready ? 'status-valid' : '' %>"><%= state.weights_ready ? 'Siap' : 'Belum siap' %></strong></div>
</div>

<form method="post" action="/swara/weights" id="weights-form">
  <input type="hidden" name="csrf" value="<%= csrf %>">
  <input type="hidden" name="useRecommendedWeights" id="use-recommended-weights" value="0">
  <div class="card table-wrap" style="margin-top:18px">
    <table><thead><tr><th>No.</th><th>Kode</th><th>Kriteria</th><th>Jenis</th><th>Bobot Final SWARA</th></tr></thead><tbody>
      <% criteria.forEach((criterion,index) => { %><tr><td><%= index + 1 %></td><td><strong><%= criterion.code %></strong></td><td class="criteria-name"><%= criterion.name %></td><td><span class="badge <%= criterion.type === 'cost' ? 'cost' : '' %>"><%= criterion.type.toUpperCase() %></span></td><td><input class="weight-input" data-weight data-code="<%= criterion.code %>" type="text" inputmode="decimal" name="weights[<%= criterion.id %>]" value="<%= number(criterion.weight,6) %>" required></td></tr><% }) %>
    </tbody><tfoot><tr><td colspan="4"><strong>Total Bobot</strong></td><td><strong id="weight-table-total"><%= number(totalWeight,6) %></strong></td></tr></tfoot></table>
  </div>
  <div class="actions"><button class="btn" id="save-weights">Simpan Bobot Final</button><span class="muted">Total bobot boleh selisih kecil karena pembulatan desimal.</span></div>
</form>

<script>
  const weightInputs = [...document.querySelectorAll('[data-weight]')];
  const totalHeader = document.getElementById('weight-total');
  const totalTable = document.getElementById('weight-table-total');
  const status = document.getElementById('weight-status');
  const button = document.getElementById('save-weights');
  const useRecommendedWeights = document.getElementById('use-recommended-weights');
  function parseWeight(value) {
    const matches = String(value).trim().replace(/,/g, '.').match(/\d+(?:\.\d+)?/g);
    if (!matches?.length) return NaN;
    return Number(matches.at(-1));
  }
  function updateWeightTotal() {
    const values = weightInputs.map((input) => parseWeight(input.value));
    const invalid = values.some((value) => !Number.isFinite(value) || value < 0 || value > 1);
    const total = values.reduce((sum, value) => sum + (Number.isFinite(value) ? value : 0), 0);
    const valid = !invalid && Math.abs(total - 1) <= 0.00001;
    totalHeader.textContent = invalid ? 'Periksa input' : total.toFixed(6);
    totalTable.textContent = invalid ? 'Periksa input' : total.toFixed(6);
    status.textContent = valid ? 'Siap disimpan' : 'Total belum 1';
    status.classList.toggle('status-valid', valid);
    button.disabled = !valid;
  }
  weightInputs.forEach((input) => input.addEventListener('input', () => {
    useRecommendedWeights.value = '0';
    updateWeightTotal();
  }));
  updateWeightTotal();
</script>

<%- include('partials/footer') %>
