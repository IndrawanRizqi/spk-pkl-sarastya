<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Masuk | SPK Sarastya</title><link rel="stylesheet" href="/style.css"></head>
<body class="login-page"><div class="login-card"><img class="login-logo" src="/sarastya-logo.png" alt="Logo Sarastya Agility Innovations"><h1>Sarastya Agility Innovations</h1><p>Sistem Pendukung Keputusan Rekrutmen PKL/Magang</p>
<% if (flash) { %><div class="notice <%= flash.type === 'error' ? 'error' : '' %>"><%= flash.message %></div><% } %>
<form method="post" action="/login"><input type="hidden" name="csrf" value="<%= csrf %>"><div class="field"><label>Username</label><input name="username" required autofocus></div><div class="field" style="margin-top:15px"><label>Password</label><input type="password" name="password" required></div><button class="btn" style="width:100%;margin-top:22px">Masuk ke Sistem</button></form>
<p class="auth-switch">Belum memiliki akun Tim Rekrutmen? <a href="/register">Daftar di sini</a></p></div></body></html>
