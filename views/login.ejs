<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Masuk | SPK Sarastya</title><link rel="stylesheet" href="/public/style.css"></head>
<body class="login-page"><div class="login-card"><img class="login-logo" src="/public/sarastya-logo.png" alt="Logo Sarastya Agility Innovations"><h1>Seleksi PKL/Magang</h1><p>Sistem pendukung keputusan Sarastya Agility Innovations dengan SWARA dan MABAC.</p>
<% if (flash) { %><div class="notice <%= flash.type === 'error' ? 'error' : '' %>"><%= flash.message %></div><% } %>
