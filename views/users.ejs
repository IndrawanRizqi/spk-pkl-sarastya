<%- include('partials/header') %>
<div class="page-head">
  <div>
    <h1>Kelola Akun Tim Rekrutmen</h1>
  </div>
</div>

<div class="card">
  <h2>Daftar Akun Tim Rekrutmen</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Nama</th>
          <th>Username</th>
          <th>Unit Bisnis</th>
          <th>Status Akun</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (!users.length) { %>
          <tr class="empty-table-row">
            <td colspan="5">Belum Ada Akun Tim Rekrutmen</td>
          </tr>
        <% } %>
        <% for (const account of users) { %>
          <tr>
            <td><strong><%= account.name %></strong></td>
            <td><%= account.username %></td>
            <td><span class="badge unit"><%= account.business_unit %></span></td>
            <td>
              <span class="badge account-<%= account.account_status %>">
                <%= account.account_status === 'active' ? 'Disetujui' : account.account_status === 'inactive' ? 'Nonaktif' : account.account_status === 'rejected' ? 'Ditolak' : 'Menunggu' %>
              </span>
              <% if (account.score_count) { %>
                <div class="muted tiny-text"><%= account.score_count %> data penilaian tersimpan</div>
              <% } %>
            </td>
            <td>
              <% if (account.account_status === 'active') { %>
                <form method="post" action="/users/<%= account.id %>/inactivate" class="account-action" onsubmit="return confirm('Nonaktifkan akun Tim Rekrutmen ini? Riwayat penilaian tetap tersimpan.')">
                  <input type="hidden" name="csrf" value="<%= csrf %>">
                  <button class="btn danger small">Nonaktif</button>
                </form>
              <% } else if (account.account_status === 'inactive') { %>
                <form method="post" action="/users/<%= account.id %>/status" class="account-action">
                  <input type="hidden" name="csrf" value="<%= csrf %>">
                  <input type="hidden" name="business_unit" value="<%= account.business_unit %>">
                  <button class="btn small" name="account_status" value="active">Aktifkan</button>
                </form>
              <% } else { %>
                <form method="post" action="/users/<%= account.id %>/status" class="account-action">
                  <input type="hidden" name="csrf" value="<%= csrf %>">
                  <input type="hidden" name="business_unit" value="<%= account.business_unit %>">
                  <button class="btn small" name="account_status" value="active">Setujui</button>
                  <button class="btn danger small" name="account_status" value="rejected">Tolak</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<div class="modal-backdrop" id="inactivate-account-modal" hidden>
  <div class="modal-card danger-modal" role="dialog" aria-modal="true" aria-labelledby="inactivate-account-title">
    <div class="modal-icon danger-icon">!</div>
    <h2 id="inactivate-account-title">Nonaktifkan Akun?</h2>
    <p id="inactivate-account-message">Akun Tim Rekrutmen akan dinonaktifkan dan tidak bisa login sementara. Riwayat penilaian tetap tersimpan.</p>
    <div class="modal-actions">
      <button class="btn secondary" type="button" data-close-inactivate>Batal</button>
      <button class="btn danger" type="button" data-confirm-inactivate-submit>Nonaktifkan</button>
    </div>
  </div>
</div><%- include('partials/footer') %>
